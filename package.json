{
  "name": "@rayzerrek/dot-cli",
  "version": "1.1.0",
  "description": "Link, copy, and commit dotfiles across Windows, macOS, and Linux",
  "keywords": [
    "dotfiles",
    "cli",
    "configuration",
    "symlink",
    "cross-platform",
    "git"
  ],
  "homepage": "https://github.com/Rayzerrek/dot-cli#readme",
  "bugs": {
    "url": "https://github.com/Rayzerrek/dot-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayzerrek/dot-cli.git"
  },
  "bin": {
    "dot": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "config.example.jsonc"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsgo",
    "test": "npm run build && node --test test/*.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260623.1"
  }
}
