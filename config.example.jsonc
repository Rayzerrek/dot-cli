{
  // Omit dotfilesDir when keeping this config in your dotfiles repository.
  "dotfilesDir": "~/dotfiles",
  "links": {
    ".gitconfig": "~/.gitconfig",
    "nvim": {
      // Omit a platform to skip this entry there.
      "windows": "~/AppData/Local/nvim",
      "macos": "~/.config/nvim",
      "linux": "~/.config/nvim"
    }
  }
}
